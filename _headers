  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self' https://identity.netlify.com; connect-src 'self' https://identity.netlify.com; form-action 'self' https://identity.netlify.com; frame-src 'self' https://identity.netlify.com; frame-ancestors 'self'; base-uri 'self'

/authorised-access.html
  X-Robots-Tag: noindex, nofollow, noarchive